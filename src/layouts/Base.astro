---
import { Font } from "astro:assets";
import "../styles/global.css";
import { FORM_URL, NOMBRE, ruta } from "../lib/sitio";

interface Props {
  title: string;
  description: string;
  /** Fuera de Google. Una página con `noindex` también se saca del sitemap en `astro.config.ts`. */
  noindex?: boolean;
  /** Datos estructurados de schema.org. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const pathname = Astro.url.pathname; // incluye la base
const canonical = new URL(pathname, Astro.site).href;
const imagen = new URL(ruta("/og.png"), Astro.site).href;
const nav = [
  { href: ruta("/calculadora/"), texto: "Calculadora" },
  { href: ruta("/demo/"), texto: "Demo" },
];
const actual = (href: string) =>
  pathname === href ? "page" : pathname.startsWith(href) ? "true" : undefined;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={NOMBRE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${NOMBRE}: la cobranza de tus lotes, al día y sin Excel`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f6f8f7"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0d1311"
    />
    <!-- El SVG es el icono; el `.ico` es para lo que no lee SVG (y para quien pide
         `/favicon.ico` sin mirar el HTML). `sizes` evita que Chrome prefiera el `.ico`. -->
    <link rel="icon" href={ruta("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={ruta("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={ruta("/apple-touch-icon.png")} />
    <link rel="sitemap" href={ruta("/sitemap-index.xml")} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")}
      />
    )}
  </head>
  <body>
    <a class="saltar" href="#contenido">
      Saltar al contenido
    </a>
    <header class="cabecera">
      <div class="contenedor cabecera-fila">
        <a class="marca" href={ruta("/")}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" class="marca-fondo"></rect>
            <rect
              x="7"
              y="7"
              width="8"
              height="8"
              rx="1.5"
              class="marca-lote"
            ></rect>
            <rect
              x="17"
              y="7"
              width="8"
              height="8"
              rx="1.5"
              class="marca-lote tenue"
            ></rect>
            <rect
              x="7"
              y="17"
              width="8"
              height="8"
              rx="1.5"
              class="marca-lote tenue"
            ></rect>
            <rect
              x="17"
              y="17"
              width="8"
              height="8"
              rx="1.5"
              class="marca-oro"
            ></rect>
          </svg>
          {NOMBRE}
        </a>
        <nav aria-label="Principal">
          <ul>
            {nav.map(({ href, texto }) => (
              <li>
                <a href={href} aria-current={actual(href)}>
                  {texto}
                </a>
              </li>
            ))}
          </ul>
          <a class="btn btn-primario btn-chico" href={FORM_URL}>
            Únete al piloto
          </a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor pie-fila">
        <div class="pie-marca">
          <strong>{NOMBRE}</strong>
          <p>
            Cobranza de lotes en abonos para desarrolladoras que venden con
            financiamiento directo.
          </p>
        </div>
        <nav aria-label="Pie de página">
          <ul>
            <li>
              <a href={ruta("/")}>Inicio</a>
            </li>
            <li>
              <a href={ruta("/calculadora/")}>Calculadora de plan de pagos</a>
            </li>
            <li>
              <a href={ruta("/demo/")}>Demo del portal</a>
            </li>
            <li>
              <a href={FORM_URL}>Registro al piloto</a>
            </li>
          </ul>
        </nav>
      </div>
      <p class="contenedor pie-legal">
        Las herramientas de este sitio son de apoyo: no sustituyen la asesoría
        legal ni el criterio de tu responsable de cumplimiento antilavado. ©{" "}
        {new Date().getFullYear()} {NOMBRE}.
      </p>
    </footer>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    z-index: 10;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    transform: translateY(-200%);

    &:focus {
      transform: none;
    }
  }

  .cabecera {
    position: sticky;
    inset-block-start: 0;
    z-index: 5;
    border-block-end: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    /* En la transición entre páginas se queda quieta en vez de fundirse con el resto. */
    view-transition-name: cabecera;
  }

  .cabecera-fila {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-block-size: 4rem;
    padding-block: 0.5rem;
  }

  .marca {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;

    & svg {
      inline-size: 1.9rem;
      block-size: 1.9rem;
    }
  }

  .marca-fondo {
    fill: var(--accent);
  }

  .marca-lote {
    fill: var(--on-accent);
  }

  .tenue {
    opacity: 0.55;
  }

  .marca-oro {
    fill: var(--gold);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cabecera nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;

    & ul a {
      color: var(--muted);
      font-weight: 500;
      text-decoration: none;

      &:hover,
      &[aria-current] {
        color: var(--ink);
      }

      &[aria-current] {
        text-decoration: underline 2px var(--accent);
        text-underline-offset: 0.45em;
      }
    }
  }

  @media (max-width: 30rem) {
    .cabecera .btn {
      display: none;
    }
  }

  .pie {
    margin-block-start: clamp(3rem, 8vw, 5rem);
    padding-block: 2.5rem 2rem;
    border-block-start: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .pie-fila {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    justify-content: space-between;

    & strong {
      color: var(--ink);
      font-family: var(--font-display);
      font-size: 1.1rem;
    }

    & p {
      max-inline-size: 42ch;
      margin: 0.35rem 0 0;
    }

    & ul {
      flex-direction: column;
      gap: 0.4rem;
    }

    & a {
      color: var(--muted);

      &:hover {
        color: var(--ink);
      }
    }
  }

  .pie-legal {
    margin-block: 2rem 0;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--line);
    font-size: 0.8rem;
  }
</style>
