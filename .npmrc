# Política de cadena de suministro. Requiere npm >= 11.16 (`devEngines` en package.json): uno más
# viejo ignora estas claves con un aviso y la instalación sigue sin blindaje.
#
# Una versión recién publicada no entra hasta que cumple 7 días: los paquetes secuestrados se
# suelen detectar y retirar antes. Para un parche de seguridad urgente, `min-release-age-exclude`.
min-release-age=7
# Un script de instalación que no esté decidido en `allowScripts` de package.json hace fallar la
# instalación. Se decide con `npm approve-scripts` / `npm deny-scripts`.
strict-allow-scripts=true
# Nada de dependencias desde git: corren `git` contra un remoto que el proyecto no controla.
allow-git=none
# Un Node o un npm fuera de `engines`/`devEngines` falla en vez de avisar.
engine-strict=true
